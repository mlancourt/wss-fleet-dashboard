{
  "name": "wss-fleet-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "WSS Fleet — employee-facing ops board. Static app shell + Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "mock": "node tools/make-mock-data.js",
    "icons": "node tools/make-icons.js",
    "test": "node tools/selftest-dates.mjs && node tools/selftest-api.mjs",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --port 8788",
    "start": "node tools/serve.js",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "m1": "bash tools/m1-loop.sh",
    "m3": "bash tools/m3-check.sh"
  },
  "devDependencies": {
    "wrangler": "^4.128.0"
  }
}
